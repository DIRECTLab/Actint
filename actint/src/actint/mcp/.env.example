# Environment Configuration for AIS Vessel Intelligence MCP System
# Copy this to .env and customize for your deployment

# ============================================================================
# MCP Server Configuration
# ============================================================================
MCP_HOST=0.0.0.0
MCP_PORT=8001

# ============================================================================
# LLM Server Configuration  
# ============================================================================
LLM_SERVER_HOST=0.0.0.0
LLM_SERVER_PORT=8000

# Model to use (options: Qwen/Qwen3.5-9B, Qwen/Qwen2-7B, mistralai/Mistral-7B-v0.1)
LLM_MODEL=Qwen/Qwen3.5-9B

# Device for LLM inference (auto, cuda, cpu)
LLM_DEVICE=auto

# MCP Server URL for LLM to communicate with
MCP_SERVER_URL=http://localhost:8001

# Query logging file
QUERY_LOG_FILE=/tmp/ais_queries.jsonl

# ============================================================================
# Database Configuration
# ============================================================================
# These should point to your AIS database
# The system uses actint.data_processing.query_database for data access
DATABASE_URL=sqlite:///./ais_data.db

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Performance Tuning
# ============================================================================
# Number of workers for FastAPI server
WORKERS=1

# Request timeout (seconds)
REQUEST_TIMEOUT=60
